{
  "expo": {
    "name": "PackSure",
    "slug": "packsure",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "packsure",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FBF9F5",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.packsure.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PackSure uses the camera to scan packaged food labels, barcodes, and nutrition facts."
      }
    },
    "android": {
      "package": "com.packsure.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenLabel uses the camera to scan barcodes and ingredient labels.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02e98dd3-abb4-4148-bfdc-d23d8be61617"
      }
    },
    "owner": "armaan.ux"
  }
}