# TruthLens / PackSure Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=8000

# Voice (optional). Speech uses Sarvam AI when both lines below are set; otherwise Gemini TTS.
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
